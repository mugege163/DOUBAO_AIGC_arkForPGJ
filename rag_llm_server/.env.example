# ============================================
# 票管家Ai客服 - 环境变量配置模板
# ============================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 将所有 YOUR_*_HERE 替换为真实值
# 3. 不要将 .env 文件提交到 Git
# ============================================

# ============================================
# 火山引擎凭证
# ============================================
# 获取方式: https://console.volcengine.com/iam/keymanage/
VOLC_ACCESS_KEY=YOUR_VOLC_ACCESS_KEY_HERE
VOLC_SECRET_KEY=YOUR_VOLC_SECRET_KEY_HERE

# 火山引擎主账号ID (知识库服务需要)
# 获取方式: 火山引擎控制台 - 账号中心
VOLC_ACCOUNT_ID=kb-2580e8a6357082fb

# ============================================
# RTC 实时通信配置
# ============================================
# 获取方式: https://console.volcengine.com/rtc/aigc/listRTC
RTC_APP_ID=YOUR_RTC_APP_ID_HERE
RTC_APP_KEY=YOUR_RTC_APP_KEY_HERE

# ============================================
# 豆包大模型配置 (Ark)
# ============================================
# 获取方式: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
ARK_API_KEY=YOUR_ARK_API_KEY_HERE

# 模型端点ID
# 获取方式: Ark控制台 - 在线推理 - 创建推理接入点
ARK_ENDPOINT_ID=ep-2024xxxxxxxxxxxxx

# ============================================
# 服务器配置
# ============================================
# 本地开发使用 localhost
# 生产环境使用实际域名
SERVER_URL=http://localhost:3001

# ============================================
# 知识库配置 (RAG)
# ============================================
# 知识库集合名称
KB_COLLECTION_NAME=ticket_guide

# 知识库项目名称
KB_PROJECT_NAME=default

# ============================================
# 可选配置
# ============================================
# Python 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 是否启用调试模式
DEBUG=true
